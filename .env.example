# Copy to .env (git-ignored) and fill in. Variables already set in the shell take precedence.
# Hugging Face Read token; its account must have accepted the pyannote and ai4bharat model terms.
HF_TOKEN=
# Ollama models (default: qwen3:8b for both). The planner model also labels domains, transliterates and, unless
# MONITOR_MODEL is set, reviews every step (MONITOR_MODEL=none turns the monitor off).
CODER_MODEL=qwen3:8b-fp16
PLANNER_MODEL=qwen3:8b-fp16
# LLM-as-a-judge scores only (default: PLANNER_MODEL); the 70B model needs ~75 GB of GPU memory
# JUDGE_MODEL=llama3.3:70b-instruct-q8_0
# Optional: SPEAKER_DB=<folder> (speakers remembered across batches; none = off), REPLAN=0 (no re-planning round),
# PUBLIC_INDEX=<folder> (public-corpus index for the duplicate check), ASR_ENGINE=wav2vec (the old ASR)
